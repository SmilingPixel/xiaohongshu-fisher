{
	"name": "xiaohongshu-fisher",
	"publisher": "SmilingPixel",
	"displayName": "Xiaohongshu Fisher",
	"description": "%extension.description%",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/SmilingPixel/xiaohongshu-fisher.git"
	},
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:xiaohongshuFisher.homeFeed",
		"onView:xiaohongshuFisher.exploreFeed",
		"onView:xiaohongshuFisher.searchResults"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "Xiaohongshu Fisher",
			"properties": {
				"xiaohongshu-fisher.browserMode": {
					"type": "string",
					"enum": [
						"headless",
						"window"
					],
					"enumDescriptions": [
						"%settings.browserMode.headless%",
						"%settings.browserMode.window%"
					],
					"default": "headless",
					"scope": "machine",
					"description": "%settings.browserMode.description%"
				}
			}
		},
		"commands": [
			{
				"command": "xiaohongshu-fisher.refreshHomeFeed",
				"title": "%commands.refreshHomeFeed%",
				"icon": "$(refresh)"
			},
			{
				"command": "xiaohongshu-fisher.refreshExploreFeed",
				"title": "%commands.refreshExploreFeed%",
				"icon": "$(refresh)"
			},
			{
				"command": "xiaohongshu-fisher.searchNotes",
				"title": "%commands.searchNotes%",
				"icon": "$(search)"
			},
			{
				"command": "xiaohongshu-fisher.loadMore",
				"title": "%commands.loadMore%",
				"icon": "$(more)"
			},
			{
				"command": "xiaohongshu-fisher.openNote",
				"title": "%commands.openNote%"
			},
			{
				"command": "xiaohongshu-fisher.openInBrowser",
				"title": "%commands.openInBrowser%",
				"icon": "$(link-external)"
			},
			{
				"command": "xiaohongshu-fisher.openLogin",
				"title": "%commands.openLogin%",
				"icon": "$(sign-in)"
			},
			{
				"command": "xiaohongshu-fisher.refreshLoginQr",
				"title": "%commands.refreshLoginQr%"
			},
			{
				"command": "xiaohongshu-fisher.installBrowserRuntime",
				"title": "%commands.installBrowserRuntime%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "xiaohongshu-fisher.clearSession",
				"title": "%commands.clearSession%",
				"icon": "$(trash)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "xiaohongshuFisher",
					"title": "%views.container%",
					"icon": "resources/xiaohongshu.svg"
				}
			]
		},
		"views": {
			"xiaohongshuFisher": [
				{
					"id": "xiaohongshuFisher.homeFeed",
					"name": "%views.homeFeed%"
				},
				{
					"id": "xiaohongshuFisher.exploreFeed",
					"name": "%views.exploreFeed%"
				},
				{
					"id": "xiaohongshuFisher.searchResults",
					"name": "%views.searchResults%"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "xiaohongshu-fisher.refreshHomeFeed",
					"when": "view == xiaohongshuFisher.homeFeed",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.refreshExploreFeed",
					"when": "view == xiaohongshuFisher.exploreFeed",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.searchNotes",
					"when": "view == xiaohongshuFisher.searchResults",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.homeFeed",
					"group": "navigation@1"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.exploreFeed",
					"group": "navigation@1"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.searchResults",
					"group": "navigation@1"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "xiaohongshuFisher.homeFeed",
				"contents": "%welcome.homeFeed%"
			},
			{
				"view": "xiaohongshuFisher.exploreFeed",
				"contents": "%welcome.exploreFeed%"
			},
			{
				"view": "xiaohongshuFisher.searchResults",
				"contents": "%welcome.searchResults%"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run compile && pnpm run test:package",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package",
		"pretest": "pnpm run compile && pnpm run lint",
		"lint": "eslint . --max-warnings 0 && pnpm run format:check && pnpm run l10n:check",
		"lint:fix": "eslint . --fix --max-warnings 0 && pnpm run format",
		"format": "prettier --write src \"*.{json,mjs}\" .vscode \"l10n/*.json\"",
		"format:check": "prettier --check src \"*.{json,mjs}\" .vscode \"l10n/*.json\"",
		"test": "pnpm run test:unit && vscode-test",
		"test:unit": "node --test out/test/unit/*.test.js",
		"test:package": "node --test out/test/packaging.test.js",
		"l10n:export": "vscode-l10n-dev export -o l10n src",
		"l10n:check": "node --test l10n-check.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/qrcode": "^1.5.6",
		"@types/vscode": "^1.140.0",
		"@vscode/l10n-dev": "^0.0.35",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"dependencies": {
		"@vscode/l10n": "^0.0.18",
		"playwright": "^1.63.0",
		"qrcode": "^1.5.4"
	},
	"l10n": "./l10n"
}
