{
  "name": "xiaohongshu-fisher",
  "publisher": "SmilingPixel",
  "displayName": "Xiaohongshu Fisher",
  "description": "Browse and read Xiaohongshu notes from Visual Studio Code.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmilingPixel/xiaohongshu-fisher.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:xiaohongshuFisher.homeFeed",
    "onView:xiaohongshuFisher.exploreFeed",
    "onView:xiaohongshuFisher.searchResults"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xiaohongshu-fisher.refreshHomeFeed",
        "title": "xiaohongshu-fisher: 刷新推荐",
        "icon": "$(refresh)"
      },
      {
        "command": "xiaohongshu-fisher.refreshExploreFeed",
        "title": "xiaohongshu-fisher: 刷新发现",
        "icon": "$(refresh)"
      },
      {
        "command": "xiaohongshu-fisher.searchNotes",
        "title": "xiaohongshu-fisher: 搜索小红书笔记",
        "icon": "$(search)"
      },
      {
        "command": "xiaohongshu-fisher.loadMore",
        "title": "xiaohongshu-fisher: 加载更多",
        "icon": "$(more)"
      },
      {
        "command": "xiaohongshu-fisher.openNote",
        "title": "xiaohongshu-fisher: 打开笔记"
      },
      {
        "command": "xiaohongshu-fisher.openInBrowser",
        "title": "xiaohongshu-fisher: 在浏览器中打开",
        "icon": "$(link-external)"
      },
      {
        "command": "xiaohongshu-fisher.openLogin",
        "title": "xiaohongshu-fisher: 打开小红书扫码登录",
        "icon": "$(sign-in)"
      },
      {
        "command": "xiaohongshu-fisher.refreshLoginQr",
        "title": "xiaohongshu-fisher: 刷新小红书登录二维码"
      },
      {
        "command": "xiaohongshu-fisher.installBrowserRuntime",
        "title": "xiaohongshu-fisher: 安装 Playwright Chromium",
        "icon": "$(cloud-download)"
      },
      {
        "command": "xiaohongshu-fisher.clearSession",
        "title": "xiaohongshu-fisher: 清除小红书会话",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xiaohongshuFisher",
          "title": "小红书",
          "icon": "resources/xiaohongshu.svg"
        }
      ]
    },
    "views": {
      "xiaohongshuFisher": [
        {
          "id": "xiaohongshuFisher.homeFeed",
          "name": "推荐"
        },
        {
          "id": "xiaohongshuFisher.exploreFeed",
          "name": "发现"
        },
        {
          "id": "xiaohongshuFisher.searchResults",
          "name": "搜索结果"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "xiaohongshu-fisher.refreshHomeFeed",
          "when": "view == xiaohongshuFisher.homeFeed",
          "group": "navigation"
        },
        {
          "command": "xiaohongshu-fisher.refreshExploreFeed",
          "when": "view == xiaohongshuFisher.exploreFeed",
          "group": "navigation"
        },
        {
          "command": "xiaohongshu-fisher.searchNotes",
          "when": "view == xiaohongshuFisher.searchResults",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile && pnpm run test:package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "pnpm run test:unit && vscode-test",
    "test:unit": "node --test out/test/unit/*.test.js",
    "test:package": "node --test out/test/packaging.test.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4"
  }
}
