{
	"name": "xiaohongshu-fisher",
	"publisher": "SmilingPixel",
	"displayName": "Xiaohongshu Fisher",
	"description": "Browse and read Xiaohongshu notes from Visual Studio Code.",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/SmilingPixel/xiaohongshu-fisher.git"
	},
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:xiaohongshuFisher.homeFeed",
		"onView:xiaohongshuFisher.exploreFeed",
		"onView:xiaohongshuFisher.searchResults"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "Xiaohongshu Fisher",
			"properties": {
				"xiaohongshu-fisher.browserMode": {
					"type": "string",
					"enum": [
						"headless",
						"window"
					],
					"enumDescriptions": [
						"不显示浏览器窗口。登录和内容浏览共用同一会话。",
						"使用普通 Chromium，需要图形桌面。启动或打开页面时可能出现窗口弹出、跳动或焦点切换；自动最小化也可能失败，影响使用体验。"
					],
					"default": "headless",
					"scope": "machine",
					"description": "浏览器运行模式，默认使用不显示窗口的 headless 模式。更改后请重新加载 VS Code 窗口。"
				}
			}
		},
		"commands": [
			{
				"command": "xiaohongshu-fisher.refreshHomeFeed",
				"title": "xiaohongshu-fisher: 刷新推荐",
				"icon": "$(refresh)"
			},
			{
				"command": "xiaohongshu-fisher.refreshExploreFeed",
				"title": "xiaohongshu-fisher: 刷新发现",
				"icon": "$(refresh)"
			},
			{
				"command": "xiaohongshu-fisher.searchNotes",
				"title": "xiaohongshu-fisher: 搜索小红书笔记",
				"icon": "$(search)"
			},
			{
				"command": "xiaohongshu-fisher.loadMore",
				"title": "xiaohongshu-fisher: 加载更多",
				"icon": "$(more)"
			},
			{
				"command": "xiaohongshu-fisher.openNote",
				"title": "xiaohongshu-fisher: 打开笔记"
			},
			{
				"command": "xiaohongshu-fisher.openInBrowser",
				"title": "xiaohongshu-fisher: 在浏览器中打开",
				"icon": "$(link-external)"
			},
			{
				"command": "xiaohongshu-fisher.openLogin",
				"title": "xiaohongshu-fisher: 打开小红书扫码登录",
				"icon": "$(sign-in)"
			},
			{
				"command": "xiaohongshu-fisher.refreshLoginQr",
				"title": "xiaohongshu-fisher: 刷新小红书登录二维码"
			},
			{
				"command": "xiaohongshu-fisher.installBrowserRuntime",
				"title": "xiaohongshu-fisher: 安装 Playwright Chromium",
				"icon": "$(cloud-download)"
			},
			{
				"command": "xiaohongshu-fisher.clearSession",
				"title": "xiaohongshu-fisher: 清除小红书会话",
				"icon": "$(trash)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "xiaohongshuFisher",
					"title": "小红书",
					"icon": "resources/xiaohongshu.svg"
				}
			]
		},
		"views": {
			"xiaohongshuFisher": [
				{
					"id": "xiaohongshuFisher.homeFeed",
					"name": "推荐"
				},
				{
					"id": "xiaohongshuFisher.exploreFeed",
					"name": "发现"
				},
				{
					"id": "xiaohongshuFisher.searchResults",
					"name": "搜索结果"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "xiaohongshu-fisher.refreshHomeFeed",
					"when": "view == xiaohongshuFisher.homeFeed",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.refreshExploreFeed",
					"when": "view == xiaohongshuFisher.exploreFeed",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.searchNotes",
					"when": "view == xiaohongshuFisher.searchResults",
					"group": "navigation"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.homeFeed",
					"group": "navigation@1"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.exploreFeed",
					"group": "navigation@1"
				},
				{
					"command": "xiaohongshu-fisher.openLogin",
					"when": "view == xiaohongshuFisher.searchResults",
					"group": "navigation@1"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "xiaohongshuFisher.homeFeed",
				"contents": "首次使用？先用小红书 App 扫码登录。\n[扫码登录](command:xiaohongshu-fisher.openLogin)\n已有会话？[直接刷新推荐](command:xiaohongshu-fisher.refreshHomeFeed)。"
			},
			{
				"view": "xiaohongshuFisher.exploreFeed",
				"contents": "首次使用？先用小红书 App 扫码登录。\n[扫码登录](command:xiaohongshu-fisher.openLogin)\n已有会话？[直接刷新发现](command:xiaohongshu-fisher.refreshExploreFeed)。"
			},
			{
				"view": "xiaohongshuFisher.searchResults",
				"contents": "首次使用？先用小红书 App 扫码登录。\n[扫码登录](command:xiaohongshu-fisher.openLogin)\n已有会话？[直接搜索笔记](command:xiaohongshu-fisher.searchNotes)。"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "pnpm run compile && pnpm run test:package",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "vsce package",
		"pretest": "pnpm run compile && pnpm run lint",
		"lint": "eslint . --max-warnings 0 && pnpm run format:check",
		"lint:fix": "eslint . --fix --max-warnings 0 && pnpm run format",
		"format": "prettier --write src \"*.{json,mjs}\" .vscode",
		"format:check": "prettier --check src \"*.{json,mjs}\" .vscode",
		"test": "pnpm run test:unit && vscode-test",
		"test:unit": "node --test out/test/unit/*.test.js",
		"test:package": "node --test out/test/packaging.test.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/qrcode": "^1.5.6",
		"@types/vscode": "^1.140.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"dependencies": {
		"playwright": "^1.63.0",
		"qrcode": "^1.5.4"
	}
}
